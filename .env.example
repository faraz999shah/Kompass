# ---- API (copy to api/.env; the API reads .env from the folder it runs in) ----

# LLM for lesson wording and translation. Without a key, only English lessons are served.
LLM_API_KEY=
# Chat model id; required when LLM_API_KEY is set
LLM_MODEL=
# Optional: timeout in seconds, base URL and reasoning effort
# LLM_TIMEOUT_SECONDS=20
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_REASONING_EFFORT=low

# Gemini key for speech-to-text and read-aloud. Without it, voice endpoints return 503
# and the app speaks on the device. The same key can also run lessons through Gemini's
# OpenAI-compatible endpoint:
#   LLM_API_KEY=<same key>, LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/,
#   LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Optional: model fallback order (JSON lists)
# GEMINI_TRANSCRIBE_MODELS='["gemini-3.5-transcribe","gemini-3.5-flash-lite"]'
# GEMINI_TTS_MODELS='["gemini-3.8-flash-tts","gemini-2.5-flash-preview-tts"]'

# Optional voice limits: recording size in bytes, speech timeout, requests per client per minute
# VOICE_MAX_AUDIO_BYTES=5242880
# VOICE_PROVIDER_TIMEOUT_SECONDS=20
# VOICE_REQUESTS_PER_MINUTE=30
# Local development without a Gemini key: /v1/voice/transcribe returns a sample question
# VOICE_DEV_FIXTURES=true

API_BASE_URL=
# SQLite file for profiles and quizzes (relative to api/)
DATABASE_PATH=kompass.db
# Optional: where the question bank, base lessons and Findex data are read from
# QUESTION_BANK_DIR=../data/question_bank
# LESSON_TEMPLATES_DIR=../data/lesson_templates
# FINDEX_DIR=../data/findex
# Browser origins allowed to call the API (JSON list); defaults to Expo web on :8081
# CORS_ALLOWED_ORIGINS=["http://localhost:8081"]
# Local only: serve the lesson tester at /dev/lesson-tester
# DEV_TOOLS_ENABLED=true

# ---- App (put in app/.env; it is bundled into the app, so never a key) ----

# API URL; use your computer's LAN address, e.g. http://192.168.1.23:8000, on a phone
EXPO_PUBLIC_API_URL=http://localhost:8000
